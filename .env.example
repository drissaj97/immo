# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Base de données PostgreSQL (Supabase ou local via docker-compose)
DATABASE_URL=postgresql://darbladi:darbladi_dev@localhost:5432/darbladi

# Authentification (JWT local pour MVP ; remplaçable par Supabase Auth)
AUTH_SECRET=change-me-to-a-random-32-char-secret-minimum

# Supabase (optionnel — pour migration future)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Intelligence artificielle (optionnel — mode mock si absent)
OPENAI_API_KEY=
AI_PROVIDER=mock
AI_MAX_TOKENS=4096
AI_RATE_LIMIT_PER_MINUTE=20

# Cartographie
NEXT_PUBLIC_MAP_STYLE=https://demotiles.maplibre.org/style.json

# Email transactionnel (optionnel)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@darbladi.ma

# Taux de change (source indicative)
EXCHANGE_RATE_SOURCE=banque_al_maghrib
EXCHANGE_RATE_API_URL=

# Feature flags
ENABLE_DESIGN_SYSTEM=true
DEMO_MODE=true
